@{
    ViewData["Title"] = "Вхід адміністратора";
}

<div class="atm-screen">
    <div class="atm-card admin-login-card">
        <div class="atm-header">
            <div class="admin-icon-badge">
                <span class="material-symbols-rounded">admin_panel_settings</span>
            </div>
            <h1>Адміністратор</h1>
            <p>Введіть пароль для доступу до панелі керування</p>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="form-group mb-4">
                <label class="form-label text-center">Пароль доступу</label>
                <input type="password"
                       name="password"
                       class="form-control text-center admin-password-input font-mono"
                       placeholder="••••••••"
                       autofocus />
            </div>

            <button type="submit" class="btn-atm">
                Увійти
            </button>
            <a href="/Auth/InsertCard" class="btn-atm-outline mt-2">
                Повернутися до банкомата
            </a>
        </form>
    </div>
</div>
