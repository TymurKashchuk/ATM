@model AtmSimulator.ViewModels.CreateAccountViewModel

@{
    ViewData["Title"] = "Створити акаунт";
}

<div class="atm-screen">
    <div class="atm-card admin-form-card">
        <div class="atm-header">
            <div class="admin-icon-badge">
                <span class="material-symbols-rounded">person_add</span>
            </div>
            <h1>Новий акаунт</h1>
            <p>Реєстрація нового клієнта в банківській системі</p>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label asp-for="OwnerName" class="form-label">Ім'я власника</label>
                <input asp-for="OwnerName" class="form-control" placeholder="Іван Іваненко" autofocus />
                <span asp-validation-for="OwnerName" class="text-danger mt-1 d-block"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CardNumber" class="form-label">Номер картки (16 цифр)</label>
                <input asp-for="CardNumber"
                       class="form-control card-format-input font-mono"
                       placeholder="0000 0000 0000 0000"
                       maxlength="19"
                       inputmode="numeric" />
                <span asp-validation-for="CardNumber" class="text-danger mt-1 d-block"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Pin" class="form-label">PIN (4 цифри)</label>
                <input asp-for="Pin"
                       class="form-control text-center font-mono pin-change-input"
                       maxlength="4"
                       type="password"
                       placeholder="••••"
                       inputmode="numeric" />
                <span asp-validation-for="Pin" class="text-danger mt-1 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="InitialBalance" class="form-label">Початковий баланс (₴)</label>
                <input asp-for="InitialBalance" class="form-control font-mono" placeholder="0.00" />
                <span asp-validation-for="InitialBalance" class="text-danger mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn-atm">Створити акаунт</button>
            <a href="/Admin/Index" class="btn-atm-outline mt-2">Скасувати</a>
        </form>
    </div>
</div>
