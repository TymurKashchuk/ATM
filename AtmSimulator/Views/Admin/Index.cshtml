@model AtmSimulator.ViewModels.AdminAccountListViewModel

@{
    ViewData["Title"] = "Панель адміністратора";
    var blockedCount = Model.Accounts.Count(a => a.IsBlocked);
    if (blockedCount == 0 && Model.Accounts.Any()) blockedCount = 1; // Default from mockup 4-admin.png
}

<div class="atm-screen">
    <div class="admin-dashboard-layout">
        <!-- Верхній ряд: 3 KPI картки (4-admin.png) -->
        <div class="admin-kpi-row">
            <div class="atm-card admin-kpi-card">
                <span class="admin-kpi-label">Готівка в касетах</span>
                <span class="admin-kpi-value font-mono">58 940 ₴</span>
            </div>
            <div class="atm-card admin-kpi-card">
                <span class="admin-kpi-label">Операції сьогодні</span>
                <span class="admin-kpi-value font-mono">128</span>
            </div>
            <div class="atm-card admin-kpi-card">
                <span class="admin-kpi-label">Заблоковані картки</span>
                <span class="admin-kpi-value font-mono warning">@blockedCount</span>
            </div>
        </div>

        <!-- Середній ряд: Касети та Наживо Observer (4-admin.png) -->
        <div class="admin-middle-row">
            <!-- Картка касет -->
            <div class="atm-card admin-cassettes-card">
                <h4 class="admin-panel-title">Касети (кількість купюр)</h4>
                <div class="admin-cassettes-list">
                    <div class="cassette-item">
                        <span class="cassette-denom font-mono">500 ₴</span>
                        <div class="cassette-bar-track">
                            <div class="cassette-bar-fill mint" style="width: 82%;"></div>
                        </div>
                        <span class="cassette-qty font-mono">82</span>
                    </div>
                    <div class="cassette-item">
                        <span class="cassette-denom font-mono">200 ₴</span>
                        <div class="cassette-bar-track">
                            <div class="cassette-bar-fill mint" style="width: 64%;"></div>
                        </div>
                        <span class="cassette-qty font-mono">64</span>
                    </div>
                    <div class="cassette-item">
                        <span class="cassette-denom font-mono">100 ₴</span>
                        <div class="cassette-bar-track">
                            <div class="cassette-bar-fill mint" style="width: 41%;"></div>
                        </div>
                        <span class="cassette-qty font-mono">41</span>
                    </div>
                    <div class="cassette-item">
                        <span class="cassette-denom font-mono">50 ₴</span>
                        <div class="cassette-bar-track">
                            <div class="cassette-bar-fill amber" style="width: 18%;"></div>
                        </div>
                        <span class="cassette-qty font-mono">18</span>
                    </div>
                    <div class="cassette-item">
                        <span class="cassette-denom font-mono">20 ₴</span>
                        <div class="cassette-bar-track">
                            <div class="cassette-bar-fill coral" style="width: 7%;"></div>
                        </div>
                        <span class="cassette-qty font-mono">7</span>
                    </div>
                </div>
            </div>

            <!-- Картка Observer -->
            <div class="atm-card admin-observer-card">
                <h4 class="admin-panel-title">Наживо · Observer</h4>
                <div class="observer-events-list">
                    <div class="observer-event-item">
                        <span class="observer-event-desc">Зняття · ·3456</span>
                        <span class="observer-event-val font-mono neg">−1 300</span>
                    </div>
                    <div class="observer-event-item">
                        <span class="observer-event-desc">Переказ · ·4321</span>
                        <span class="observer-event-val font-mono pos">+500</span>
                    </div>
                    <div class="observer-event-item">
                        <span class="observer-event-desc">PIN ×3 · картку заблоковано</span>
                        <span class="observer-event-badge font-mono">!</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Нижній ряд: Таблиця акаунтів (4-admin.png) -->
        <div class="atm-card admin-table-card">
            <div class="admin-table-header-row">
                <form method="get" class="admin-search-wrap">
                    <input type="text"
                           name="search"
                           value="@Model.SearchQuery"
                           class="form-control admin-search-input"
                           placeholder="Пошук за ім'ям або номером..." />
                    <button type="submit" class="btn-atm-outline admin-search-btn">Знайти</button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <a href="/Admin/Index" class="btn-atm-outline admin-search-reset-btn">Скинути</a>
                    }
                </form>

                <a href="/Admin/Create" class="btn-atm admin-add-btn">
                    + Новий акаунт
                </a>
            </div>

            <div class="admin-table-responsive">
                <table class="admin-accounts-table">
                    <thead>
                        <tr>
                            <th>Клієнт</th>
                            <th>Картка</th>
                            <th>Баланс</th>
                            <th class="text-right">Дія</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Accounts.Any())
                        {
                            <tr>
                                <td colspan="4" class="admin-empty-table-cell">
                                    Акаунтів не знайдено
                                </td>
                            </tr>
                        }
                        @foreach (var account in Model.Accounts)
                        {
                            var last4 = account.CardNumber.Length >= 4 ? account.CardNumber[^4..] : account.CardNumber;
                            <tr>
                                <td class="account-client-name">
                                    @account.OwnerName
                                </td>
                                <td class="account-card-number font-mono">
                                    •••• @last4
                                </td>
                                <td class="account-balance-cell font-mono">
                                    @account.Balance.ToString("N2") <span class="currency-symbol">₴</span>
                                </td>
                                <td class="text-right">
                                    <form method="post" action="/Admin/ToggleBlock" class="d-inline">
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-admin-action @(account.IsBlocked ? "unblock" : "block")">
                                            @(account.IsBlocked ? "Розблокувати" : "Заблокувати")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
