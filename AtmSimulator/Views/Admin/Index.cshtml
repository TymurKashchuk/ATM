@model AtmSimulator.ViewModels.AdminAccountListViewModel

@{
    ViewData["Title"] = "Панель адміністратора";
}

<div class="atm-screen">
    <div class="atm-card admin-dashboard-card">
        <div class="admin-dashboard-header">
            <div class="admin-dashboard-title-wrap">
                <h1>Панель адміністратора</h1>
                <p class="admin-dashboard-subtitle">Керування банківськими акаунтами та картками</p>
            </div>
            <a href="/Admin/Create" class="btn-atm admin-new-account-btn">
                <span class="material-symbols-rounded">person_add</span>
                <span>+ Новий акаунт</span>
            </a>
        </div>

        <!-- Пошук акаунтів -->
        <form method="get" class="admin-search-bar">
            <div class="admin-search-input-wrap">
                <span class="material-symbols-rounded admin-search-icon">search</span>
                <input type="text"
                       name="search"
                       value="@Model.SearchQuery"
                       class="form-control admin-search-input"
                       placeholder="Пошук за ім'ям або номером картки..." />
            </div>
            <button type="submit" class="btn-atm-outline admin-search-btn">Знайти</button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <a href="/Admin/Index" class="btn-atm-outline admin-search-reset-btn">Скинути</a>
            }
        </form>

        <!-- Таблиця акаунтів (за макетом 4-admin.png) -->
        <div class="admin-table-container">
            <table class="admin-accounts-table">
                <thead>
                    <tr>
                        <th>Клієнт</th>
                        <th>Картка</th>
                        <th>Баланс</th>
                        <th>Статус</th>
                        <th class="text-right">Дія</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Accounts.Any())
                    {
                        <tr>
                            <td colspan="5" class="admin-empty-table-cell">
                                <p>Акаунтів за вашим запитом не знайдено</p>
                            </td>
                        </tr>
                    }
                    @foreach (var account in Model.Accounts)
                    {
                        var last4 = account.CardNumber.Length >= 4 ? account.CardNumber[^4..] : account.CardNumber;
                        <tr>
                            <td class="account-client-name">
                                <strong>@account.OwnerName</strong>
                            </td>
                            <td class="account-card-number font-mono">
                                •••• @last4
                            </td>
                            <td class="account-balance-cell font-mono">
                                @account.Balance.ToString("N2") ₴
                            </td>
                            <td>
                                @if (account.IsBlocked)
                                {
                                    <span class="admin-status-badge blocked">Заблокована</span>
                                }
                                else
                                {
                                    <span class="admin-status-badge active">Активна</span>
                                }
                            </td>
                            <td class="text-right">
                                <form method="post" action="/Admin/ToggleBlock" class="d-inline">
                                    <input type="hidden" name="accountId" value="@account.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-admin-action @(account.IsBlocked ? "unblock" : "block")">
                                        @(account.IsBlocked ? "Розблокувати" : "Заблокувати")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
