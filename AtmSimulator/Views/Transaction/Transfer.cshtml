@model AtmSimulator.ViewModels.TransferViewModel

@{
    ViewData["Title"] = "Transfer";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 480px;">
        <div class="atm-header">
            <h1>Переказ коштів</h1>
            <p class="text-muted">Поточний баланс: <strong style="color:#4ade80">@Model.CurrentBalance.ToString("N2") ₴</strong></p>
        </div>

        <div style="background:#111a30; border:1px solid #1a4a7a; border-radius:8px; padding:0.6rem 0.9rem; margin-bottom:1.25rem; font-size:0.8rem; color:#94a3b8;">
            <div>Тарифи комісії:</div>
            <div style="display:flex; justify-content:space-between; margin-top:0.25rem;">
                <span>• На картки нашого банку:</span>
                <strong style="color:#4ade80;">0%</strong>
            </div>
            <div style="display:flex; justify-content:space-between; margin-top:0.15rem;">
                <span>• На сторонні картки:</span>
                <strong style="color:#fcd34d;">2%</strong>
            </div>
        </div>

        <form asp-action="Transfer" method="post" id="transferForm">
            <input type="hidden" id="SenderCardNumber" value="@Model.SenderCardNumber" />

            <div class="form-group">
                <label asp-for="RecipientCardNumber" class="form-label">Номер картки одержувача (16 цифр)</label>
                <input asp-for="RecipientCardNumber"
                       id="RecipientCardNumber"
                       class="form-control"
                       placeholder="1234 5678 9012 3456"
                       maxlength="16"
                       oninput="calculateTransferDetails()" />
                <span asp-validation-for="RecipientCardNumber" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Amount" class="form-label">Сума переказу (₴)</label>
                <input asp-for="Amount"
                       id="TransferAmount"
                       class="form-control"
                       placeholder="наприклад, 500"
                       oninput="calculateTransferDetails()" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div id="transferCostBox" style="background:#0f2942; border:1px solid #1a4a7a; border-radius:8px; padding:0.75rem; margin-top:1rem; display:none;">
                <div style="display:flex; justify-content:space-between; font-size:0.85rem; color:#cbd5e1;">
                    <span id="transferTypeLabel">Тип переказу:</span>
                    <span id="transferTypeBadge" style="font-weight:600;">Внутрішній (0%)</span>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:0.85rem; color:#cbd5e1; margin-top:0.25rem;">
                    <span>Комісія:</span>
                    <span id="transferFeeDisplay" style="color:#fcd34d; font-weight:600;">0.00 ₴</span>
                </div>
                <div style="display:flex; justify-content:space-between; font-size:0.95rem; font-weight:bold; color:#e0e0e0; margin-top:0.25rem; border-top:1px solid #1a4a7a; padding-top:0.25rem;">
                    <span>Разом до списання:</span>
                    <span id="transferTotalDisplay" style="color:#4ade80;">0.00 ₴</span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3"></div>

            <button type="submit" class="btn-atm mt-4">Переказати кошти →</button>
            <a asp-controller="Account" asp-action="Index" class="btn-atm-outline mt-2">← Скасувати</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function calculateTransferDetails() {
            const senderCard = (document.getElementById('SenderCardNumber').value || '').trim();
            const recipientCard = (document.getElementById('RecipientCardNumber').value || '').trim();
            const amount = parseFloat(document.getElementById('TransferAmount').value) || 0;
            const box = document.getElementById('transferCostBox');

            if (amount > 0 && recipientCard.length >= 6) {
                box.style.display = 'block';

                const senderBin = senderCard.substring(0, 6);
                const recipientBin = recipientCard.substring(0, 6);
                const isExternal = (senderBin !== recipientBin);

                const fee = isExternal ? Math.round(amount * 0.02 * 100) / 100 : 0;
                const total = amount + fee;

                if (isExternal) {
                    document.getElementById('transferTypeBadge').innerText = 'Стороння картка (2%)';
                    document.getElementById('transferTypeBadge').style.color = '#fcd34d';
                } else {
                    document.getElementById('transferTypeBadge').innerText = 'Картка банку (0%)';
                    document.getElementById('transferTypeBadge').style.color = '#4ade80';
                }

                document.getElementById('transferFeeDisplay').innerText = fee.toFixed(2) + ' ₴';
                document.getElementById('transferTotalDisplay').innerText = total.toFixed(2) + ' ₴';
            } else {
                box.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', calculateTransferDetails);
    </script>
}
