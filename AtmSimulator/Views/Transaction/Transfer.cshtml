@model AtmSimulator.ViewModels.TransferViewModel

@{
    ViewData["Title"] = "Переказ на картку";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 480px;">
        <div class="atm-header">
            <h1>Переказ на картку</h1>
            <p class="text-muted">Миттєвий переказ за 16-значним номером</p>
        </div>

        <div class="balance-box" style="padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
            <p class="balance-label" style="margin-bottom: 0.15rem;">Доступно для переказу</p>
            <p class="balance-amount" style="font-size: 1.5rem;">@Model.CurrentBalance.ToString("N2") ₴</p>
        </div>

        <form asp-action="Transfer" method="post">
            <div class="form-group mb-3">
                <label asp-for="RecipientCardNumber" class="form-label">Номер картки отримувача</label>
                <div style="position: relative;">
                    <input asp-for="RecipientCardNumber"
                           class="form-control"
                           placeholder="1234 5678 9012 3456"
                           maxlength="16"
                           style="letter-spacing: 0.08em; font-family: monospace; font-size: 1.05rem; padding-left: 2.5rem;" />
                    <div style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); opacity: 0.6; display: flex;">
                        <img src="~/icons/contactless.svg" alt="Card" class="svg-icon" style="width: 18px; height: 18px;" />
                    </div>
                </div>
                <span asp-validation-for="RecipientCardNumber" class="text-danger mt-1 d-block"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Amount" class="form-label">Сума переказу (₴)</label>
                <div style="position: relative;">
                    <input asp-for="Amount"
                           class="form-control"
                           placeholder="Наприклад: 500"
                           style="font-size: 1.25rem; font-weight: 700; padding-left: 2.25rem;" />
                    <span style="position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--text-muted);">₴</span>
                </div>
                <span asp-validation-for="Amount" class="text-danger mt-1 d-block"></span>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3"></div>

            <button type="submit" class="btn-atm mt-4">
                <img src="~/icons/transfer.svg" alt="Transfer" class="svg-icon" style="width: 18px; height: 18px;" />
                <span>Надіслати переказ</span>
            </button>
            <a asp-controller="Account" asp-action="Index" class="btn-atm-outline mt-2">
                <img src="~/icons/arrow-left.svg" alt="Back" class="svg-icon" style="width: 18px; height: 18px;" />
                <span>Назад у меню</span>
            </a>
        </form>
    </div>
</div>
