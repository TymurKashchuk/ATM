@model AtmSimulator.ViewModels.TransactionHistoryViewModel

@{
    ViewData["Title"] = "Історія операцій";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 640px;">
        <div class="atm-header">
            <h1>Історія операцій</h1>
            <p class="text-muted">Усього операцій за карткою: @Model.TotalCount</p>
        </div>

        @if (!Model.Transactions.Any())
        {
            <div style="text-align: center; padding: 3rem 1rem;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: var(--surface-subtle); border: 2px solid var(--border-subtle); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">
                    <span class="material-symbols-rounded" style="color: var(--text-muted); font-size: 32px;">receipt_long</span>
                </div>
                <h4 style="font-weight: 700; color: var(--text-heading); margin-bottom: 0.25rem;">Транзакцій поки немає</h4>
                <p style="color: var(--text-muted); font-size: 0.95rem;">Усі виконані операції будуть відображатися тут</p>
            </div>
        }
        else
        {
            <!-- Швидкий верхній тулбар пагінації без необхідності прокручування -->
            <div class="history-toolbar">
                <span class="history-summary">
                    Показано @(Math.Min((Model.CurrentPage - 1) * 10 + 1, Model.TotalCount))–@(Math.Min(Model.CurrentPage * 10, Model.TotalCount)) з @Model.TotalCount
                </span>
                @if (Model.TotalPages > 1)
                {
                    <div class="pagination-compact">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="History" asp-route-page="@(Model.CurrentPage - 1)" class="page-btn-sm" title="Попередня сторінка">
                                <span class="material-symbols-rounded" style="font-size: 18px;">chevron_left</span>
                            </a>
                        }
                        else
                        {
                            <span class="page-btn-sm disabled">
                                <span class="material-symbols-rounded" style="font-size: 18px;">chevron_left</span>
                            </span>
                        }

                        <span class="page-badge">@Model.CurrentPage / @Model.TotalPages</span>

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="History" asp-route-page="@(Model.CurrentPage + 1)" class="page-btn-sm" title="Наступна сторінка">
                                <span class="material-symbols-rounded" style="font-size: 18px;">chevron_right</span>
                            </a>
                        }
                        else
                        {
                            <span class="page-btn-sm disabled">
                                <span class="material-symbols-rounded" style="font-size: 18px;">chevron_right</span>
                            </span>
                        }
                    </div>
                }
            </div>

            <!-- Список транзакцій зі стильним локальним скролом -->
            <div class="transaction-list">
                @foreach (var t in Model.Transactions)
                {
                    var isPositive = t.Type == AtmSimulator.Models.TransactionType.Deposit || (t.Description != null && t.Description.StartsWith("Переказ з"));

                    <div class="transaction-item">
                        <div class="transaction-icon @t.Type.ToString().ToLower()">
                            @switch (t.Type)
                            {
                                case AtmSimulator.Models.TransactionType.Withdrawal:
                                    <span class="material-symbols-rounded" style="font-size: 22px;">payments</span>
                                    break;
                                case AtmSimulator.Models.TransactionType.Deposit:
                                    <span class="material-symbols-rounded" style="font-size: 22px;">savings</span>
                                    break;
                                case AtmSimulator.Models.TransactionType.Transfer:
                                    <span class="material-symbols-rounded" style="font-size: 22px;">swap_horiz</span>
                                    break;
                            }
                        </div>
                        <div class="transaction-info">
                            <h4 class="transaction-type">
                                @switch (t.Type)
                                {
                                    case AtmSimulator.Models.TransactionType.Withdrawal:
                                        <span>Зняття готівки</span>
                                        break;
                                    case AtmSimulator.Models.TransactionType.Deposit:
                                        <span>Поповнення рахунку</span>
                                        break;
                                    case AtmSimulator.Models.TransactionType.Transfer:
                                        <span>Грошовий переказ</span>
                                        break;
                                }
                            </h4>
                            <p class="transaction-date">@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                        <div class="transaction-amount @(isPositive ? "positive" : "negative")">
                            @(isPositive ? "+" : "-")@t.Amount.ToString("N2") ₴
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="History" asp-route-page="@(Model.CurrentPage - 1)" class="page-btn" title="Попередня сторінка">
                            <span class="material-symbols-rounded" style="font-size: 20px;">chevron_left</span>
                        </a>
                    }
                    else
                    {
                        <span class="page-btn disabled">
                            <span class="material-symbols-rounded" style="font-size: 20px;">chevron_left</span>
                        </span>
                    }

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.CurrentPage)
                        {
                            <span class="page-num active">@p</span>
                        }
                        else if (p <= 3 || p > Model.TotalPages - 2 || Math.Abs(p - Model.CurrentPage) <= 1)
                        {
                            <a asp-action="History" asp-route-page="@p" class="page-num">@p</a>
                        }
                        else if (p == 4 || p == Model.TotalPages - 2)
                        {
                            <span class="page-dots">…</span>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="History" asp-route-page="@(Model.CurrentPage + 1)" class="page-btn" title="Наступна сторінка">
                            <span class="material-symbols-rounded" style="font-size: 20px;">chevron_right</span>
                        </a>
                    }
                    else
                    {
                        <span class="page-btn disabled">
                            <span class="material-symbols-rounded" style="font-size: 20px;">chevron_right</span>
                        </span>
                    }
                </div>
            }
        }

        <a asp-controller="Account" asp-action="Index" class="btn-atm-outline mt-3">
            Повернутися в головне меню
        </a>
    </div>
</div>
