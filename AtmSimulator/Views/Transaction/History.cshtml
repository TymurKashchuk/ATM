@model AtmSimulator.ViewModels.TransactionHistoryViewModel

@{
    ViewData["Title"] = "Історія операцій";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 560px;">
        <div class="atm-header">
            <h1>Історія операцій</h1>
            <p class="text-muted">Усього знайдено: @Model.TotalCount транзакцій</p>
        </div>

        @if (!Model.Transactions.Any())
        {
            <div class="empty-state">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--bg-surface); border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem auto;">
                    <img src="~/icons/history.svg" alt="Empty" class="svg-icon" style="opacity: 0.5;" />
                </div>
                <p>Історія операцій поки що порожня</p>
            </div>
        }
        else
        {
            <div class="transaction-list">
                @foreach (var t in Model.Transactions)
                {
                    var isPositive = t.Type == AtmSimulator.Models.TransactionType.Deposit || (t.Description != null && t.Description.StartsWith("Переказ з"));

                    <div class="transaction-item">
                        <div class="transaction-icon @t.Type.ToString().ToLower()">
                            @switch (t.Type)
                            {
                                case AtmSimulator.Models.TransactionType.Withdrawal:
                                    <img src="~/icons/withdraw.svg" alt="Withdraw" class="svg-icon" style="width: 18px; height: 18px;" />
                                    break;
                                case AtmSimulator.Models.TransactionType.Deposit:
                                    <img src="~/icons/deposit.svg" alt="Deposit" class="svg-icon" style="width: 18px; height: 18px;" />
                                    break;
                                case AtmSimulator.Models.TransactionType.Transfer:
                                    <img src="~/icons/transfer.svg" alt="Transfer" class="svg-icon" style="width: 18px; height: 18px;" />
                                    break;
                            }
                        </div>
                        <div class="transaction-info">
                            <p class="transaction-type">
                                @switch (t.Type)
                                {
                                    case AtmSimulator.Models.TransactionType.Withdrawal:
                                        <span>Зняття готівки</span>
                                        break;
                                    case AtmSimulator.Models.TransactionType.Deposit:
                                        <span>Поповнення рахунку</span>
                                        break;
                                    case AtmSimulator.Models.TransactionType.Transfer:
                                        <span>Грошовий переказ</span>
                                        break;
                                }
                            </p>
                            <p class="transaction-date">@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                        <div class="transaction-amount @(isPositive ? "positive" : "negative")">
                            @(isPositive ? "+" : "-")@t.Amount.ToString("N2") ₴
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="History" asp-route-page="@(Model.CurrentPage - 1)" class="page-btn">
                            <img src="~/icons/arrow-left.svg" alt="Prev" class="svg-icon" style="width: 16px; height: 16px;" />
                        </a>
                    }
                    <span class="page-info">Сторінка @Model.CurrentPage з @Model.TotalPages</span>
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="History" asp-route-page="@(Model.CurrentPage + 1)" class="page-btn" style="transform: rotate(180deg);">
                            <img src="~/icons/arrow-left.svg" alt="Next" class="svg-icon" style="width: 16px; height: 16px;" />
                        </a>
                    }
                </div>
            }
        }

        <a asp-controller="Account" asp-action="Index" class="btn-atm-outline mt-3">
            <img src="~/icons/arrow-left.svg" alt="Back" class="svg-icon" style="width: 18px; height: 18px;" />
            <span>Назад у меню</span>
        </a>
    </div>
</div>
