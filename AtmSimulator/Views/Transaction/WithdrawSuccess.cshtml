@model AtmSimulator.ViewModels.WithdrawalViewModel

@{
    ViewData["Title"] = "Готівку успішно видано";
}

<div class="atm-screen">
    <div class="atm-card operation-card">
        <div class="atm-header">
            <div class="success-icon-badge">
                <span class="material-symbols-rounded">check_circle</span>
            </div>
            <h1>Готівку видано</h1>
            <p>Будь ласка, заберіть купюри з лотка термінала</p>
        </div>

        <!-- Електронний касовий чек термінала (темна тема) -->
        <div class="receipt-card">
            <div class="receipt-header">
                <p class="receipt-title">АТМ СИМУЛЯТОР • НАЦІОНАЛЬНИЙ БАНК</p>
                <p class="receipt-sub">ТЕРМІНАЛ #0442 • КАСОВИЙ ЧЕК</p>
            </div>

            @if (Model.DispensedCash != null && Model.DispensedCash.Any())
            {
                <div class="receipt-breakdown">
                    <span class="receipt-breakdown-label">Розрахунок виданих банкнот:</span>
                    <div class="receipt-items-list">
                        @foreach (var item in Model.DispensedCash.OrderByDescending(x => x.Key))
                        {
                            <div class="receipt-item-row">
                                <div class="receipt-item-denom font-mono">
                                    <span class="denom-val">@item.Key ₴</span>
                                    <span class="denom-qty">× @item.Value шт.</span>
                                </div>
                                <span class="receipt-item-total font-mono">= @(item.Key * item.Value) ₴</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="receipt-footer">
                <span class="receipt-balance-label">Залишок на рахунку:</span>
                <span class="receipt-balance-val font-mono">@Model.CurrentBalance.ToString("N2") ₴</span>
            </div>
        </div>

        <a asp-controller="Account" asp-action="Index" class="btn-atm">
            Повернутися в головне меню
        </a>
    </div>
</div>
