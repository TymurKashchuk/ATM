@model AtmSimulator.ViewModels.DepositViewModel

@{
    ViewData["Title"] = "Deposit Cash";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 480px;">
        <div class="atm-header">
            <h1>Поповнення рахунку</h1>
            <p class="text-muted">Поточний баланс: <strong style="color:#4ade80">@Model.CurrentBalance.ToString("N2") ₴</strong></p>
            <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 0.25rem;">Оберіть кількість купюр кожного номіналу</p>
        </div>

        <form asp-action="Deposit" method="post" id="depositForm">
            <div class="banknotes-container mb-3" style="display: flex; flex-direction: column; gap: 0.75rem;">
                @for (int i = 0; i < Model.Banknotes.Count; i++)
                {
                    var denom = Model.Banknotes[i].Denomination;
                    <input type="hidden" asp-for="Banknotes[i].Denomination" value="@denom" />

                    <div class="banknote-row" style="display: flex; align-items: center; justify-content: space-between; background: #0f3460; padding: 0.6rem 0.9rem; border-radius: 8px; border: 1px solid #1a4a7a;">
                        <div style="font-weight: 700; font-size: 1.1rem; color: #e0e0e0; min-width: 80px;">
                            @denom ₴
                        </div>

                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="changeCount(@i, -1)" style="width: 34px; height: 34px; font-weight: bold; color: #fff; border-color: #334e68;">-</button>
                            <input asp-for="Banknotes[i].Count"
                                   id="count_@i"
                                   data-denom="@denom"
                                   class="form-control text-center banknote-input"
                                   style="width: 65px; height: 34px; padding: 0.2rem; font-weight: bold; background: #1a1a2e; color: #fff; border: 1px solid #1a4a7a;"
                                   type="number"
                                   min="0"
                                   max="100"
                                   value="@Model.Banknotes[i].Count"
                                   onchange="recalculateTotal()"
                                   oninput="recalculateTotal()" />
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="changeCount(@i, 1)" style="width: 34px; height: 34px; font-weight: bold; color: #fff; border-color: #334e68;">+</button>
                        </div>
                    </div>
                }
            </div>

            <div class="balance-box mt-3" style="background: #111a30; border: 1px solid #1a4a7a; border-radius: 8px; padding: 0.85rem; text-align: center;">
                <p class="balance-label" style="margin-bottom: 0.25rem; font-size: 0.85rem; color: #94a3b8;">Разом до внесення:</p>
                <p class="balance-amount" id="totalAmountDisplay" style="color: #4ade80; font-size: 1.4rem; font-weight: bold; margin: 0;">0.00 ₴</p>
                <small id="totalBillsDisplay" style="color: #94a3b8; font-size: 0.8rem;">(0 купюр)</small>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3"></div>

            <button type="submit" class="btn-atm mt-4" id="submitDepositBtn">Внести готівку →</button>
            <a asp-controller="Account" asp-action="Index" class="btn-atm-outline mt-2">← Скасувати</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function changeCount(index, delta) {
            const input = document.getElementById('count_' + index);
            if (!input) return;
            let current = parseInt(input.value) || 0;
            let updated = current + delta;
            if (updated < 0) updated = 0;
            if (updated > 100) updated = 100;
            input.value = updated;
            recalculateTotal();
        }

        function recalculateTotal() {
            let totalAmount = 0;
            let totalBills = 0;
            const inputs = document.querySelectorAll('.banknote-input');

            inputs.forEach(input => {
                const count = parseInt(input.value) || 0;
                const denom = parseInt(input.getAttribute('data-denom')) || 0;
                if (count > 0) {
                    totalBills += count;
                    totalAmount += count * denom;
                }
            });

            document.getElementById('totalAmountDisplay').innerText = totalAmount.toLocaleString('uk-UA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₴';
            document.getElementById('totalBillsDisplay').innerText = `(${totalBills} купюр)`;
        }

        document.addEventListener('DOMContentLoaded', recalculateTotal);
    </script>
}
