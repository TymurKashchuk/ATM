@model AtmSimulator.ViewModels.DepositViewModel

@{
    ViewData["Title"] = "Поповнення готівкою";
}

<div class="atm-screen">
    <div class="atm-card operation-card" style="max-width: 520px;">
        <div class="atm-header">
            <div class="operation-balance-badge">
                <span>Поточний баланс</span>
                <span class="val">@Model.CurrentBalance.ToString("N2") ₴</span>
            </div>
            <h1>Поповнення рахунку</h1>
            <p class="text-muted" style="font-size:0.85rem; margin-top:0.35rem;">Оберіть кількість банкнот кожного номіналу для внесення</p>
        </div>

        <form asp-action="Deposit" method="post" id="depositForm">
            @Html.AntiForgeryToken()

            <div class="banknotes-container mb-3" style="display: flex; flex-direction: column; gap: 0.65rem;">
                @for (int i = 0; i < Model.Banknotes.Count; i++)
                {
                    var denom = Model.Banknotes[i].Denomination;
                    <input type="hidden" asp-for="Banknotes[i].Denomination" value="@denom" />

                    <div class="banknote-row" style="display: flex; align-items: center; justify-content: space-between; background: rgba(15, 23, 42, 0.6); padding: 0.6rem 0.9rem; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08);">
                        <div style="font-weight: 700; font-size: 1.1rem; color: #f8fafc; min-width: 80px;">
                            @denom ₴
                        </div>

                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="changeCount(@i, -1)" style="width: 34px; height: 34px; font-weight: bold; color: #fff; border-color: rgba(255,255,255,0.2);">-</button>
                            <input asp-for="Banknotes[i].Count"
                                   id="count_@i"
                                   data-denom="@denom"
                                   class="form-control text-center banknote-input"
                                   style="width: 65px; height: 34px; padding: 0.2rem; font-weight: bold; background: rgba(2, 6, 23, 0.8); color: #fff; border: 1px solid rgba(255,255,255,0.15);"
                                   type="number"
                                   min="0"
                                   max="100"
                                   value="@Model.Banknotes[i].Count"
                                   onchange="recalculateTotal()"
                                   oninput="recalculateTotal()" />
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="changeCount(@i, 1)" style="width: 34px; height: 34px; font-weight: bold; color: #fff; border-color: rgba(255,255,255,0.2);">+</button>
                        </div>
                    </div>
                }
            </div>

            <div class="balance-box mt-3" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 0.85rem; text-align: center;">
                <p class="balance-label" style="margin-bottom: 0.25rem; font-size: 0.85rem; color: #94a3b8;">Разом до внесення:</p>
                <p class="balance-amount" id="totalAmountDisplay" style="color: #4ade80; font-size: 1.4rem; font-weight: bold; margin: 0;">0.00 ₴</p>
                <small id="totalBillsDisplay" style="color: #94a3b8; font-size: 0.8rem;">(0 купюр)</small>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3"></div>

            <button type="submit" class="btn-atm mt-4" id="submitDepositBtn">
                Внести готівку →
            </button>
            <a asp-controller="Account" asp-action="Index" class="btn-atm-outline mt-2">
                Повернутися в меню
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function changeCount(index, delta) {
            const input = document.getElementById('count_' + index);
            if (!input) return;
            let current = parseInt(input.value) || 0;
            let updated = current + delta;
            if (updated < 0) updated = 0;
            if (updated > 100) updated = 100;
            input.value = updated;
            recalculateTotal();
        }

        function recalculateTotal() {
            let totalAmount = 0;
            let totalBills = 0;
            const inputs = document.querySelectorAll('.banknote-input');

            inputs.forEach(input => {
                const count = parseInt(input.value) || 0;
                const denom = parseInt(input.getAttribute('data-denom')) || 0;
                if (count > 0) {
                    totalBills += count;
                    totalAmount += count * denom;
                }
            });

            document.getElementById('totalAmountDisplay').innerText = totalAmount.toLocaleString('uk-UA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₴';
            document.getElementById('totalBillsDisplay').innerText = `(${totalBills} купюр)`;
        }

        document.addEventListener('DOMContentLoaded', recalculateTotal);
    </script>
}
