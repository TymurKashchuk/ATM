@model AtmSimulator.ViewModels.DepositViewModel

@{
    ViewData["Title"] = "Поповнення готівкою";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 480px;">
        <div class="atm-header">
            <h1>Поповнення готівкою</h1>
            <p class="text-muted">Внесення банкнот у купюроприймач термінала</p>
        </div>

        <div class="balance-box" style="padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
            <p class="balance-label" style="margin-bottom: 0.15rem;">Поточний баланс</p>
            <p class="balance-amount" style="font-size: 1.5rem;">@Model.CurrentBalance.ToString("N2") ₴</p>
        </div>

        <form asp-action="Deposit" method="post">
            <div class="form-group mb-3">
                <label asp-for="Amount" class="form-label">Сума поповнення (кратна 20 ₴)</label>
                <div style="position: relative;">
                    <input asp-for="Amount"
                           id="Amount"
                           class="form-control"
                           placeholder="Наприклад: 1000"
                           style="font-size: 1.25rem; font-weight: 700; padding-left: 2.25rem;" />
                    <span style="position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--text-muted);">₴</span>
                </div>
                <span asp-validation-for="Amount" class="text-danger mt-1 d-block"></span>
            </div>

            <!-- Швидкі суми -->
            <label class="form-label">Швидкі суми поповнення:</label>
            <div class="quick-amounts" style="margin-top: 0;">
                <button type="button" class="quick-btn" onclick="setAmount(500)">500 ₴</button>
                <button type="button" class="quick-btn" onclick="setAmount(1000)">1 000 ₴</button>
                <button type="button" class="quick-btn" onclick="setAmount(2000)">2 000 ₴</button>
                <button type="button" class="quick-btn" onclick="setAmount(5000)">5 000 ₴</button>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3"></div>

            <button type="submit" class="btn-atm mt-4">
                <img src="~/icons/deposit.svg" alt="Deposit" class="svg-icon" style="width: 18px; height: 18px;" />
                <span>Внести кошти</span>
            </button>
            <a asp-controller="Account" asp-action="Index" class="btn-atm-outline mt-2">
                <img src="~/icons/arrow-left.svg" alt="Back" class="svg-icon" style="width: 18px; height: 18px;" />
                <span>Назад у меню</span>
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function setAmount(val) {
            document.getElementById('Amount').value = val;
        }
    </script>
}
