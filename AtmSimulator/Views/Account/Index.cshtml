@model AtmSimulator.ViewModels.AccountViewModel

@{
    ViewData["Title"] = "Головне меню";
    var last4 = Model.CardNumber.Length >= 4 ? Model.CardNumber[^4..] : Model.CardNumber;
}

<div class="atm-screen">
    <div class="menu-dashboard">
        <!-- Ліва колонка: картка та баланс -->
        <div class="menu-left-col">
            <!-- Плашка банківської картки (за макетом 2-menu.png) -->
            <div class="bank-card">
                <div class="bank-card-header">
                    <div class="bank-card-chip">
                        <div class="bank-card-chip-cell"></div>
                        <div class="bank-card-chip-cell"></div>
                        <div class="bank-card-chip-cell"></div>
                        <div class="bank-card-chip-cell"></div>
                    </div>
                    <div>
                        @if (Model.IsBlocked)
                        {
                            <span class="bank-card-status-pill text-danger">Заблокована</span>
                        }
                        else
                        {
                            <span class="bank-card-status-pill active">Активна</span>
                        }
                    </div>
                </div>

                <div class="bank-card-number-mid font-mono">
                    •••• &nbsp;•••• &nbsp;•••• &nbsp;@last4
                </div>

                <div class="bank-card-footer-info">
                    <p class="bank-card-holder-name">@Model.OwnerName</p>
                </div>
            </div>

            <!-- Блок балансу -->
            <div class="balance-box">
                <p class="balance-box-label">Доступний баланс</p>
                <p class="balance-box-val font-mono">
                    @Model.Balance.ToString("N2") <span class="currency-symbol">₴</span>
                </p>
            </div>
        </div>

        <!-- Права колонка: сітка дій 3x2 (за макетом 2-menu.png) -->
        <div class="menu-right-col">
            <div class="menu-grid-3x2 menu-grid">
                <a asp-controller="Transaction" asp-action="Withdraw" class="menu-card-btn menu-btn">
                    <div class="menu-card-icon menu-btn-icon">
                        <span class="material-symbols-rounded">payments</span>
                    </div>
                    <h3 class="menu-card-title menu-btn-title">Зняти готівку</h3>
                    <p class="menu-card-desc menu-btn-desc">Від 20 ₴</p>
                </a>

                <a asp-controller="Transaction" asp-action="Deposit" class="menu-card-btn menu-btn">
                    <div class="menu-card-icon menu-btn-icon">
                        <span class="material-symbols-rounded">arrow_downward</span>
                    </div>
                    <h3 class="menu-card-title menu-btn-title">Поповнити</h3>
                    <p class="menu-card-desc menu-btn-desc">Кратно 20 ₴</p>
                </a>

                <a asp-controller="Transaction" asp-action="Transfer" class="menu-card-btn menu-btn">
                    <div class="menu-card-icon menu-btn-icon">
                        <span class="material-symbols-rounded">swap_horiz</span>
                    </div>
                    <h3 class="menu-card-title menu-btn-title">Переказ</h3>
                    <p class="menu-card-desc menu-btn-desc">На картку</p>
                </a>

                <a asp-controller="Transaction" asp-action="History" class="menu-card-btn menu-btn">
                    <div class="menu-card-icon menu-btn-icon">
                        <span class="material-symbols-rounded">schedule</span>
                    </div>
                    <h3 class="menu-card-title menu-btn-title">Історія</h3>
                    <p class="menu-card-desc menu-btn-desc">Графік витрат</p>
                </a>

                <a asp-controller="Account" asp-action="ChangePin" class="menu-card-btn menu-btn">
                    <div class="menu-card-icon menu-btn-icon">
                        <span class="material-symbols-rounded">lock</span>
                    </div>
                    <h3 class="menu-card-title menu-btn-title">Зміна PIN</h3>
                    <p class="menu-card-desc menu-btn-desc">Безпека</p>
                </a>

                <a asp-controller="Auth" asp-action="Logout" class="menu-card-btn menu-btn menu-btn-danger">
                    <div class="menu-card-icon menu-btn-icon">
                        <span class="material-symbols-rounded">logout</span>
                    </div>
                    <h3 class="menu-card-title menu-btn-title">Завершити</h3>
                    <p class="menu-card-desc menu-btn-desc">Забрати картку</p>
                </a>
            </div>
        </div>
    </div>
</div>
