@using System.Text.Encodings.Web
@{
    var serverErrors = new List<string>();
    if (!ViewData.ModelState.IsValid)
    {
        foreach (var state in ViewData.ModelState.Values)
        {
            foreach (var error in state.Errors)
            {
                if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                {
                    serverErrors.Add(error.ErrorMessage);
                }
            }
        }
    }
    if (TempData["BlockedMessage"] != null)
    {
        serverErrors.Add(TempData["BlockedMessage"]!.ToString()!);
    }
    if (TempData["Error"] != null)
    {
        serverErrors.Add(TempData["Error"]!.ToString()!);
    }
    if (ViewBag.Error != null)
    {
        serverErrors.Add(ViewBag.Error.ToString()!);
    }
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Банкомат</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
    </style>
</head>
<body>
    <!-- Global Toast Container (для спливаючих повідомлень зверху) -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>

    <main class="w-100 d-flex justify-content-center">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Функція відображення toast-сповіщення (з'являється зверху та зникає через 2 секунди)
        function showToast(message, type = 'error', duration = 2000) {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `toast-notification toast-${type}`;
            
            const iconName = type === 'success' ? 'check_circle' : (type === 'warning' ? 'warning' : 'error');
            
            toast.innerHTML = `
                <span class="material-symbols-rounded toast-icon">${iconName}</span>
                <div class="toast-content">
                    <span class="toast-message">${message}</span>
                </div>
                <button type="button" class="toast-close" onclick="dismissToast(this.parentElement)" aria-label="Закрити">&times;</button>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.add('show');
            });

            setTimeout(() => {
                dismissToast(toast);
            }, duration);
        }

        function dismissToast(toast) {
            if (!toast || toast.classList.contains('hide')) return;
            toast.classList.remove('show');
            toast.classList.add('hide');
            setTimeout(() => {
                if (toast.parentElement) toast.parentElement.removeChild(toast);
            }, 300);
        }

        // Автоматичне форматування номера картки (пробіл після кожних 4 цифр + лише цифри)
        function initCardFormatting() {
            document.querySelectorAll('.card-format-input').forEach(input => {
                const format = () => {
                    let digits = input.value.replace(/\D/g, '').substring(0, 16);
                    let parts = digits.match(/.{1,4}/g);
                    input.value = parts ? parts.join(' ') : '';
                };

                input.addEventListener('input', format);
                input.addEventListener('keypress', (e) => {
                    if (!/\d/.test(e.key) && e.key !== 'Enter') {
                        e.preventDefault();
                    }
                });
                input.addEventListener('paste', () => {
                    setTimeout(format, 10);
                });

                if (input.value) format();
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            initCardFormatting();

            @foreach (var err in serverErrors)
            {
                <text>showToast('@Html.Raw(JavaScriptEncoder.Default.Encode(err))', 'error', 2000);</text>
            }

            @if (TempData["Success"] != null)
            {
                <text>showToast('@Html.Raw(JavaScriptEncoder.Default.Encode(TempData["Success"]!.ToString()!))', 'success', 2000);</text>
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
