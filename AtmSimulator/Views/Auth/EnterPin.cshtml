@model AtmSimulator.ViewModels.PinViewModel

@{
    ViewData["Title"] = "Введення PIN";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 480px;">
        <div class="atm-header">
            <div style="width: 56px; height: 56px; border-radius: 16px; background: var(--primary-light); border: 2px solid #bfdbfe; color: var(--primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">
                <span class="material-symbols-rounded" style="color: var(--primary); font-size: 30px;">pin</span>
            </div>
            <h1>Введіть PIN-код</h1>
            <p class="text-muted">Для доступу до меню та банківських операцій</p>
        </div>

        <form id="pin-form" action="/Auth/EnterPin" method="post">
            @Html.AntiForgeryToken()

            <!-- Прихований інпут для зберігання значення -->
            <input asp-for="Pin"
                   id="pin-input"
                   type="password"
                   maxlength="4"
                   style="position: absolute; opacity: 0; pointer-events: none;" />

            <!-- 4 Великі контрастні індикатори-точки -->
            <div class="pin-dots-container">
                <div id="dot-0" class="pin-dot"></div>
                <div id="dot-1" class="pin-dot"></div>
                <div id="dot-2" class="pin-dot"></div>
                <div id="dot-3" class="pin-dot"></div>
            </div>

            <!-- Реалістичний PIN-пад банкомата -->
            <div class="pin-pad-grid">
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('1')">
                    <span>1</span>
                </button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('2')">
                    <span>2</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">ABC</span>
                </button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('3')">
                    <span>3</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">DEF</span>
                </button>

                <button type="button" class="pin-pad-btn" onclick="addPinDigit('4')">
                    <span>4</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">GHI</span>
                </button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('5')">
                    <span>5</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">JKL</span>
                </button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('6')">
                    <span>6</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">MNO</span>
                </button>

                <button type="button" class="pin-pad-btn" onclick="addPinDigit('7')">
                    <span>7</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">PQRS</span>
                </button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('8')">
                    <span>8</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">TUV</span>
                </button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('9')">
                    <span>9</span>
                    <span style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: -3px;">WXYZ</span>
                </button>

                <button type="button" class="pin-pad-btn action-clear" onclick="backspacePin()" title="Стерти символ">
                    <span class="material-symbols-rounded" style="font-size: 22px;">backspace</span>
                </button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('0')">
                    <span>0</span>
                </button>
                <button type="button" class="pin-pad-btn action-clear" onclick="clearPinAll()" title="Очистити все">
                    <span>C</span>
                </button>
            </div>

            <button type="submit" class="btn-atm">
                Підтвердити
            </button>

            <a asp-action="InsertCard" class="btn-atm-outline mt-2">
                Скасувати
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const pinInput = document.getElementById('pin-input');
        const form = document.getElementById('pin-form');

        function updateDots() {
            const len = pinInput.value.length;
            for (let i = 0; i < 4; i++) {
                const dot = document.getElementById('dot-' + i);
                if (dot) {
                    dot.classList.toggle('filled', i < len);
                }
            }
        }

        function addPinDigit(digit) {
            if (pinInput.value.length < 4) {
                pinInput.value += digit;
                updateDots();
                if (pinInput.value.length === 4) {
                    setTimeout(() => form.submit(), 250);
                }
            }
        }

        function backspacePin() {
            if (pinInput.value.length > 0) {
                pinInput.value = pinInput.value.slice(0, -1);
                updateDots();
            }
        }

        function clearPinAll() {
            pinInput.value = '';
            updateDots();
        }

        document.addEventListener('keydown', function (e) {
            if (e.key >= '0' && e.key <= '9') {
                addPinDigit(e.key);
            } else if (e.key === 'Backspace') {
                backspacePin();
            } else if (e.key === 'Escape') {
                clearPinAll();
            } else if (e.key === 'Enter') {
                if (pinInput.value.length === 4) form.submit();
            }
        });
    </script>
}
