@model AtmSimulator.ViewModels.PinViewModel

@{
    ViewData["Title"] = "Введення PIN";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 400px;">
        <div class="atm-header">
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); color: var(--primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem auto;">
                <img src="~/icons/pin.svg" alt="PIN" class="svg-icon" style="color: var(--primary);" />
            </div>
            <h1>Введіть PIN-код</h1>
            <p class="text-muted">Введіть ваш 4-значний секретний код</p>
        </div>

        <form id="pin-form" action="/Auth/EnterPin" method="post">
            @Html.AntiForgeryToken()

            <!-- Прихований або синхронізований інпут -->
            <input asp-for="Pin"
                   id="pin-input"
                   type="password"
                   maxlength="4"
                   style="position: absolute; opacity: 0; pointer-events: none;" />

            <!-- Візуальні індикатори-точки -->
            <div class="pin-dots-container">
                <div id="dot-0" class="pin-dot"></div>
                <div id="dot-1" class="pin-dot"></div>
                <div id="dot-2" class="pin-dot"></div>
                <div id="dot-3" class="pin-dot"></div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            <!-- Екранний PIN-пад банкомата -->
            <div class="pin-pad-grid">
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('1')">1</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('2')">2</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('3')">3</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('4')">4</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('5')">5</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('6')">6</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('7')">7</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('8')">8</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('9')">9</button>
                <button type="button" class="pin-pad-btn action-clear" onclick="backspacePin()">⌫</button>
                <button type="button" class="pin-pad-btn" onclick="addPinDigit('0')">0</button>
                <button type="button" class="pin-pad-btn action-clear" onclick="clearPinAll()">C</button>
            </div>

            <button type="submit" class="btn-atm">
                <img src="~/icons/check.svg" alt="Confirm" class="svg-icon" style="width: 18px; height: 18px;" />
                Підтвердити
            </button>

            <a asp-action="InsertCard" class="btn-atm-outline mt-2">
                <img src="~/icons/arrow-left.svg" alt="Cancel" class="svg-icon" style="width: 18px; height: 18px;" />
                Скасувати
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const pinInput = document.getElementById('pin-input');
        const form = document.getElementById('pin-form');

        function updateDots() {
            const len = pinInput.value.length;
            for (let i = 0; i < 4; i++) {
                const dot = document.getElementById('dot-' + i);
                if (dot) {
                    dot.classList.toggle('filled', i < len);
                }
            }
        }

        function addPinDigit(digit) {
            if (pinInput.value.length < 4) {
                pinInput.value += digit;
                updateDots();
                if (pinInput.value.length === 4) {
                    // Невелика затримка для плавності перед відправкою
                    setTimeout(() => form.submit(), 250);
                }
            }
        }

        function backspacePin() {
            if (pinInput.value.length > 0) {
                pinInput.value = pinInput.value.slice(0, -1);
                updateDots();
            }
        }

        function clearPinAll() {
            pinInput.value = '';
            updateDots();
        }

        // Дозволяємо також зручно друкувати на фізичній клавіатурі
        document.addEventListener('keydown', function (e) {
            if (e.key >= '0' && e.key <= '9') {
                addPinDigit(e.key);
            } else if (e.key === 'Backspace') {
                backspacePin();
            } else if (e.key === 'Escape') {
                clearPinAll();
            } else if (e.key === 'Enter') {
                if (pinInput.value.length === 4) form.submit();
            }
        });
    </script>
}
