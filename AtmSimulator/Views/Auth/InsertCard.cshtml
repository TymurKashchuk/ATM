@model AtmSimulator.ViewModels.CardViewModel

@{
    ViewData["Title"] = "Вставте картку";
}

<div class="atm-screen">
    <div class="atm-card" style="max-width: 440px;">
        <div class="atm-header">
            <!-- Візуальний слот для картки -->
            <div style="width: 64px; height: 10px; background: #0f172a; border: 2px solid var(--border-color); border-radius: 6px; margin: 0 auto 1.25rem auto; box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);"></div>
            
            <h1>Вітаємо в банкоматі</h1>
            <p class="text-muted">Введіть 16-значний номер вашої картки</p>
        </div>

        @if (TempData["BlockedMessage"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["BlockedMessage"]</div>
        }

        <form action="/Auth/InsertCard" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group mb-3">
                <label asp-for="CardNumber" class="form-label">Номер картки</label>
                <div style="position: relative;">
                    <input asp-for="CardNumber"
                           id="card-number-input"
                           class="form-control"
                           placeholder="1234 5678 9012 3456"
                           maxlength="16"
                           style="letter-spacing: 0.1em; font-family: monospace; font-size: 1.1rem; padding-left: 2.75rem;" />
                    <div style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); opacity: 0.6; display: flex;">
                        <img src="~/icons/contactless.svg" alt="Card" class="svg-icon" style="width: 18px; height: 18px;" />
                    </div>
                </div>
                <span asp-validation-for="CardNumber" class="text-danger mt-1 d-block"></span>
            </div>

            <!-- Швидкі демо-картки для тестування -->
            <div style="background: rgba(255,255,255,0.02); border: 1px dashed var(--border-color); border-radius: 10px; padding: 0.65rem 0.85rem; margin-bottom: 1.25rem;">
                <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.35rem;">Тестові картки:</span>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button type="button" class="btn-atm-outline" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; width: auto; font-family: monospace;" onclick="document.getElementById('card-number-input').value='1234567890123456'">1234...3456</button>
                    <button type="button" class="btn-atm-outline" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; width: auto; font-family: monospace;" onclick="document.getElementById('card-number-input').value='6543210987654321'">6543...4321</button>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            <button type="submit" class="btn-atm">
                <span>Продовжити</span>
                <img src="~/icons/check.svg" alt="Go" class="svg-icon" style="width: 18px; height: 18px;" />
            </button>
        </form>
    </div>
</div>
